# Loaded by `npm start` ONLY. Create React App reads `.env.development` for the dev server and
# `.env.production` for a build, so nothing in here can reach a deployed bundle.
#
# It used to be a plain `.env`, which CRA loads for BOTH - so a build that was not given an
# explicit REACT_APP_API_BASE_URL silently baked `http://localhost:8080/api` into the bundle. That
# is what happened on Vercel: the Production environment sets the variable and was fine, the
# Preview environment does not, so every preview deployment shipped a console that called the
# reviewer's own machine and failed for a reason that looked like a backend fault.

# 3000 is crm_frontend's and 3001 is patient_portal's, so this portal takes 3002 to let all three
# run side by side. A local convention, not a secret.
PORT=3002

# Points the dev server's requests at the local backend. package.json's "proxy" would cover this
# too, but naming it explicitly means the same command works if the proxy is ever removed.
REACT_APP_API_BASE_URL=http://localhost:8080/api
