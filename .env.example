# Public backend URL including the /api suffix - same variable name as crm_frontend and
# patient_portal so all three deploy the same way. Create React App bakes this in at BUILD time,
# so changing it requires a rebuild, not just a dev-server restart.
#
# Left unset, the app falls back to /api and relies on the "proxy" field in package.json, which
# only applies to the dev server.
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Where a clinic's public page lives, used only to link out to it from the traffic table. This
# portal is a different origin from the public site, so it cannot work the address out the way
# crm_frontend does (from window.location.origin) - it has to be told. Defaults to the live site.
REACT_APP_PUBLIC_SITE_URL=https://www.easemyopd.com
